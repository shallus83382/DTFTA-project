# ============================================
# DTFTA CRM - Backend Configuration Example
# ============================================

# Copy this to your .env file and update values

# ============================================
# Application Settings
# ============================================
APP_NAME="DTFTA CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost/DTFTA_CRM

# ============================================
# Database Configuration
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dtfta_crm
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# Cache & Session
# ============================================
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ============================================
# Email Configuration (for password resets)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@dtfta.com
MAIL_FROM_NAME="DTFTA CRM"

# ============================================
# Authentication
# ============================================
# Using Laravel Sanctum for API tokens
AUTH_GUARD=sanctum

# Token expiration (minutes)
SANCTUM_TOKEN_EXPIRATION=43200

# ============================================
# CORS Configuration
# ============================================
# Set to your frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost/DTFTA_CRM

# ============================================
# Logging
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# Shopify Integration (if applicable)
# ============================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_API_VERSION=2026-04

# ============================================
# AWS/Cloud Storage (if needed)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ============================================
# Security Headers
# ============================================
SECURE_HEADERS_ENABLED=true
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRATION=1440  # 24 hours in minutes

# ============================================
# Development Settings (set to false in production)
# ============================================
TINKER_ENABLED=true
DEBUGBAR_ENABLED=false
