{
  "info": {
    "_postman_id": "8f0f7d21-c771-4d34-b43a-71b3e5ca7aaf",
    "name": "DTFTA Webhooks Only",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Webhook-only Postman collection for DTFTA Shopify integration. Includes HMAC pre-request signing and ready payloads."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = (pm.request.method || '').toUpperCase();",
          "if (method !== 'POST' && method !== 'PUT') {",
          "    return;",
          "}",
          "",
          "const secret = pm.environment.get('SHOPIFY_WEBHOOK_SECRET') || pm.collectionVariables.get('webhook_secret');",
          "if (!secret) {",
          "    console.warn('Missing SHOPIFY_WEBHOOK_SECRET in environment/collection variables.');",
          "    return;",
          "}",
          "",
          "const topic = pm.request.headers.get('X-Shopify-Topic') || pm.collectionVariables.get('topic') || '';",
          "const shopDomain = pm.request.headers.get('X-Shopify-Shop-Domain') || pm.environment.get('shop_domain') || pm.collectionVariables.get('shop_domain') || '';",
          "const webhookId = pm.request.headers.get('X-Shopify-Webhook-Id') || pm.variables.replaceIn('{{$guid}}');",
          "",
          "const bodyRaw = pm.request.body && pm.request.body.mode === 'raw'",
          "  ? pm.variables.replaceIn(pm.request.body.raw || '')",
          "  : '';",
          "",
          "const signature = CryptoJS.enc.Base64.stringify(",
          "  CryptoJS.HmacSHA256(bodyRaw, CryptoJS.enc.Utf8.parse(secret))",
          ");",
          "",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "if (topic) pm.request.headers.upsert({ key: 'X-Shopify-Topic', value: topic });",
          "if (shopDomain) pm.request.headers.upsert({ key: 'X-Shopify-Shop-Domain', value: shopDomain });",
          "if (webhookId) pm.request.headers.upsert({ key: 'X-Shopify-Webhook-Id', value: webhookId });",
          "pm.request.headers.upsert({ key: 'X-Shopify-Hmac-SHA256', value: signature });"
        ]
      }
    }
  ],
