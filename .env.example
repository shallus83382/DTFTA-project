APP_NAME=DTFTA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dtfta
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Shopify App / Webhook
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_PASSWORD=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_orders,write_fulfillments,write_assigned_fulfillment_orders,write_third_party_fulfillment_orders,write_locations,read_locations
SHOPIFY_WEBHOOK_API_VERSION=2026-04
EXTERNAL_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_APP_URL="${APP_URL}"
# Local webhook testing only (set false in production)
WEBHOOK_DEBUG=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set FILESYSTEM_DISK=s3 and fill AWS_* + AWS_COULD_FRONT_URL when using S3 (see config/filesystems.php).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_COULD_FRONT_URL=

VITE_APP_NAME="${APP_NAME}"

# Managed billing / pre-fulfillment charge
BILLING_ENFORCEMENT_ENABLED=false
SHOPIFY_BILLING_TEST_MODE=true
SHOPIFY_BILLING_PLAN_NAME="DTFTA Merchant Usage"
SHOPIFY_BILLING_RETURN_URL="${APP_URL}/billing/return"
SHOPIFY_BILLING_BASE_PRICE_AMOUNT=0
SHOPIFY_BILLING_PER_ORDER_AMOUNT=1
SHOPIFY_BILLING_USAGE_CAP_AMOUNT=1000
SHOPIFY_BILLING_CURRENCY_CODE=USD
